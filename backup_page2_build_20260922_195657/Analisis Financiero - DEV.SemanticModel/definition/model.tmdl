model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-VE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Dim_Categorias","Fact_Movimientos","Fact_Presupuestos","Dim_Fecha","Fact_Presupuestos_Quincenal"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Dim_Categorias
ref table Fact_Movimientos
ref table Fact_Presupuestos
ref table _Medidas
ref table Dim_Fecha
ref table Fact_Presupuestos_Quincenal
ref table Dim_Escenario
ref table Dim_Quincena

ref cultureInfo es-ES

