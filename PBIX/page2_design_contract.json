  "implementation_requirements": {
    "critical": [
      "For cardVisual, set typography/padding in visual.objects, not only container background/border.",
      "Do not leave KPI cards with only visualContainerObjects formatting.",
      "Disable or reduce default card padding; target 8px or less.",
      "Explicitly set value font, label font, display units and decimal places.",
      "If the existing cardVisual cannot reproduce the contract cleanly, rebuild that visual rather than preserving default formatting.",
      "After writing, reopen the actual saved visual.json and verify explicit visual-level formatting objects exist."
    ],
    "matrix": [
      "Preserve compact 9pt body/header sizing.",
      "Do not expand row padding.",
      "Keep matrix within 1098x377."
    ],
    "qa": [
      "Report actual saved bounds for every visual in this contract.",
      "Report actual card value/label font sizes read back from saved JSON.",
      "FAIL if a KPI card has no explicit value/label formatting.",
      "FAIL if Power BI theme defaults are still responsible for KPI typography."
    ]
  }
