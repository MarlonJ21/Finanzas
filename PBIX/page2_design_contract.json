{
  "spec_version": "1.0",
  "purpose": "Machine-readable visual contract for Power BI page 'Planificador Próximo Mes'",
  "diagnosis": {
    "source": "PBIX.zip inspected",
    "finding": "The current PBIR already uses the requested 1600x900 canvas and most major X/Y/Width/Height values already match the blueprint. The main mismatch is formatting inside visuals, especially cardVisual objects: many KPI cards define background/border/layout but do not explicitly define label/value typography, padding, alignment, or callout-area formatting. Power BI therefore renders defaults.",
    "implication": "Do not spend another pass mainly moving visuals. Enforce visual-level formatting properties and replace any visual that cannot match the contract."
  },
  "target_page": {
    "name": "planificador_proximo_mes",
    "displayName": "Planificador Próximo Mes",
    "width": 1600,
    "height": 900,
    "background": "#08152E",
    "displayOption": "FitToPage"
  },
  "hard_rules": {
    "treat_as_contract_not_inspiration": true,
    "coordinate_tolerance_px": 4,
    "font_tolerance_pt": 1,
    "no_auto_layout": true,
    "no_resize_to_content": true,
    "no_wrap_kpi_values": true,
    "no_default_powerbi_white_visuals": true,
    "no_numbered_blue_annotations": true,
    "do_not_modify_page1": true,
    "do_not_modify_forecast_logic": true,
    "do_not_modify_fact_presupuestos": true,
    "do_not_modify_relationships": true,
    "preserve_global_kpi_filter_protection": true,
    "if_native_visual_cannot_match": "replace_or_rebuild_visual_instead_of_keeping_default_format"
  },
