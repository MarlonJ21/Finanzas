	measure 'P2 Resumen Confianza Global' =
			FORMAT ( [P2 Confianza Alta Global], "0" ) & " Alta · " &
			FORMAT ( [P2 Confianza Media Global], "0" ) & " Media · " &
			FORMAT ( [P2 Confianza Baja Global], "0" ) & " Baja"
		displayFolder: 5. Planificador Próximo Mes\Confianza
		lineageTag: 1ce66979-beaf-4ec8-a908-fbc2aabb122b

	measure 'P2 Mensaje Ejecutivo Global' =
			VAR Escenario = SELECTEDVALUE ( Fact_Presupuestos[Escenario], "REALISTIC" )
			VAR MesPlan = [P2 Mes Plan Texto]
			VAR Final = [P2 Presupuesto Final Global USD]
			VAR Cambio = [P2 Cambio Presupuesto Global USD]
			VAR Forecast = [P2 Forecast Próximo Mes Global USD]
			VAR ExtraAgg =
			    [P2 Presupuesto Actual Global USD] - [P2 Presupuesto Final Global USD]
			RETURN
			SWITCH (
			    TRUE (),
			    Escenario = "CURRENT",
			        "Continuidad: para " & MesPlan & " el comportamiento proyectado sugiere $" & FORMAT ( Final, "#,0.00" ) & ".",
			    Escenario = "AGGRESSIVE",
			        "Escenario agresivo: presupuesto final $" & FORMAT ( Final, "#,0.00" ) & ", con ajuste de $" & FORMAT ( ABS ( ExtraAgg ), "#,0.00" ) & " frente al presupuesto actual.",
			    "Para " & MesPlan & " se recomienda un presupuesto de $" & FORMAT ( Final, "#,0.00" ) & ". Representa " &
			        IF ( Cambio >= 0, "un aumento de $", "una reducción de $" ) &
			        FORMAT ( ABS ( Cambio ), "#,0.00" ) & " frente al presupuesto operativo actual. El forecast sin ajuste sería $" &
			        FORMAT ( Forecast, "#,0.00" ) & "."
			)
		displayFolder: 5. Planificador Próximo Mes\Texto
		lineageTag: 9c34ec56-4b94-494b-b15c-94a844131fbc

	measure 'P2 Categoría Única Seleccionada' =
			VAR CategoriasDim =
			    DISTINCTCOUNT ( Dim_Categorias[IdCategoria] )
			VAR CategoriasFact =
			    DISTINCTCOUNT ( Fact_Presupuestos[IdCategoria] )
			RETURN
			IF ( CategoriasDim = 1 || CategoriasFact = 1, 1, 0 )
		formatString: 0
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: 74efbf6f-cbba-4c37-8023-01ae81dc1430

	column Value
		formatString: 0
		lineageTag: ebc78677-8c16-4b3f-a7e8-dafa34313128
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Medidas = calculated
		mode: import
		source =
				
				{ BLANK() }

	annotation PBI_Id = 83781bb23d084cc28ee72ab00d87a831

