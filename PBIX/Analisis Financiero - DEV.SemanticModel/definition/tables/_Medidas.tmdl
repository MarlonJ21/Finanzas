			    [Ingreso Sostenible Mensual]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 4. Ahorros
		lineageTag: e18f0c78-a443-46fd-ba8b-1b6bdfdd246f

	measure 'Disponible para Gastar USD' =
			
