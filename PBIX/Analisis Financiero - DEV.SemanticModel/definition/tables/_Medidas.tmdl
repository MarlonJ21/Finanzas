	measure 'P2 Mes Plan Texto' =
			VAR MesPlan = MIN ( Fact_Presupuestos[MesPlan] )
			RETURN
			FORMAT ( MesPlan, "mmmm yyyy" )
		displayFolder: 5. Planificador Próximo Mes\Texto
		lineageTag: e7e95d89-c58e-4d8e-9470-e6ab8a8cd0bf

	measure 'P2 Subtítulo Plan' =
			VAR MesPlan = [P2 Mes Plan Texto]
			VAR FechaCorte = MIN ( Fact_Presupuestos[FechaCorte] )
			RETURN
			"Planificando " & MesPlan & " · Datos disponibles hasta " & FORMAT ( FechaCorte, "dd/mm/yyyy" )
		displayFolder: 5. Planificador Próximo Mes\Texto
		lineageTag: 64bfcb9b-7e96-40e9-9f56-810a56756101

	measure 'P2 Estado Plan Texto' =
			VAR PlanningActivo =
			    IF ( [Salario Cobrado Quincena USD] > 0 && COUNTROWS ( Fact_Presupuestos ) > 0, "PLAN ACTIVO", "PLAN PENDIENTE" )
			VAR Estado = SELECTEDVALUE ( Fact_Presupuestos[EstadoPlan], "DRAFT" )
			RETURN
			PlanningActivo & " · " & Estado
		displayFolder: 5. Planificador Próximo Mes\Texto
		lineageTag: 0167fe58-eaed-42f2-9708-489345d74a22

	measure 'P2 Mensaje Ejecutivo' =
			VAR Escenario = SELECTEDVALUE ( Fact_Presupuestos[Escenario], "REALISTIC" )
			VAR MesPlan = [P2 Mes Plan Texto]
			VAR Final = [P2 Presupuesto Final USD]
			VAR Cambio = [P2 Cambio vs Presupuesto Actual USD]
			VAR Forecast = [P2 Forecast Próximo Mes USD]
			VAR ExtraAgg =
			    [P2 Presupuesto Actual USD] - [P2 Presupuesto Final USD]
			RETURN
			SWITCH (
			    TRUE (),
			    Escenario = "CURRENT",
			        "Continuidad: para " & MesPlan & " el comportamiento proyectado sugiere $" & FORMAT ( Final, "#,0.00" ) & ".",
			    Escenario = "AGGRESSIVE",
			        "Escenario agresivo: presupuesto final $" & FORMAT ( Final, "#,0.00" ) & ", con ajuste de $" & FORMAT ( ABS ( ExtraAgg ), "#,0.00" ) & " frente al presupuesto actual.",
			    "Para " & MesPlan & " se recomienda un presupuesto de $" & FORMAT ( Final, "#,0.00" ) & ". Representa " &
			        IF ( Cambio >= 0, "un aumento de $", "una reducción de $" ) &
			        FORMAT ( ABS ( Cambio ), "#,0.00" ) & " frente al presupuesto operativo actual. El forecast sin ajuste sería $" &
			        FORMAT ( Forecast, "#,0.00" ) & "."
			)
		displayFolder: 5. Planificador Próximo Mes\Texto
		lineageTag: b92849e9-d91b-49e0-995e-e93385910dd4

	measure 'P2 Delta Sugerido vs Actual USD' = [P2 Presupuesto Sugerido USD] - [P2 Presupuesto Actual USD]
		formatString: +\$#,0.00;-\$#,0.00;\$0.00
		displayFolder: 5. Planificador Próximo Mes\Análisis
		lineageTag: befdc2d6-dffc-4dd0-89d6-6d6ba072e3c5

	measure 'P2 Delta Magnitud USD' = ABS ( [P2 Delta Sugerido vs Actual USD] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5. Planificador Próximo Mes\Análisis
		lineageTag: f4a7c0c6-7393-448b-a0bb-236e6285de09

	measure 'P2 Color Delta' =
			SWITCH (
			    TRUE (),
			    [P2 Delta Sugerido vs Actual USD] > 0, "#FF6B74",
			    [P2 Delta Sugerido vs Actual USD] < 0, "#22C58B",
			    "#AEB8D0"
			)
		displayFolder: 5. Planificador Próximo Mes\Formato
		lineageTag: d73c79fa-36ce-4141-90e8-6b2dd8a3a1a7

	measure 'P2 Color Confianza' =
			SWITCH (
			    SELECTEDVALUE ( Fact_Presupuestos[ConfianzaPrediccion] ),
			    "HIGH", "#22C58B",
			    "MEDIUM", "#F4B740",
			    "LOW", "#FF6B74",
			    "#AEB8D0"
			)
		displayFolder: 5. Planificador Próximo Mes\Formato
		lineageTag: f6e5233f-9a3d-4464-b66e-ed81aa8c0fbd

	measure 'P2 Confianza Alta' =
			CALCULATE (
			    DISTINCTCOUNT ( Fact_Presupuestos[IdCategoria] ),
			    Fact_Presupuestos[ConfianzaPrediccion] = "HIGH"
			)
		formatString: 0
		displayFolder: 5. Planificador Próximo Mes\Confianza
		lineageTag: de23045d-3be9-44e9-b74b-b095f6ddf1ad

	measure 'P2 Confianza Media' =
			CALCULATE (
			    DISTINCTCOUNT ( Fact_Presupuestos[IdCategoria] ),
			    Fact_Presupuestos[ConfianzaPrediccion] = "MEDIUM"
