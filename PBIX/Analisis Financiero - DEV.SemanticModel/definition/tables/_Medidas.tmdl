	measure 'Salario Cobrado Quincena USD' =
			
			CALCULATE (
			    SUM ( Fact_Movimientos[MontoUSD] ),
			    Fact_Movimientos[Dominio] = "PERSONAL",
			    Fact_Movimientos[Categoria] = "Ingresos",
			    Fact_Movimientos[Subcategoria] = "Salario",
			    Fact_Movimientos[EsIngresoEconomico] = 1
			)
		displayFolder: 3. Ingresos
		lineageTag: 5f42366e-0b1d-445b-9f1d-a6d6ea0dcc03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ingreso Sostenible Quincenal' =
			
			DIVIDE (
			    [Ingreso Sostenible Mensual],
			    2
			)
		displayFolder: 3. Ingresos
		lineageTag: d1c40db3-54f9-4bec-8909-78c3b9f41a24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ahorro Objetivo Quincenal USD' =
			
