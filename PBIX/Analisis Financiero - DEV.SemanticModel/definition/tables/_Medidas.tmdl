	measure 'P2 Resumen Confianza' =
			FORMAT ( [P2 Confianza Alta], "0" ) & " Alta · " &
			FORMAT ( [P2 Confianza Media], "0" ) & " Media · " &
			FORMAT ( [P2 Confianza Baja], "0" ) & " Baja"
		displayFolder: 5. Planificador Próximo Mes\Confianza
		lineageTag: f4a99253-a8a2-4245-b2f9-45e9248ae137

	measure 'P2 Ajuste Simulado Seleccionado USD' = SELECTEDVALUE ( 'Ajuste Simulado USD'[Ajuste Simulado USD], 0 )
		formatString: +\$#,0;-\$#,0;\$0
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: 0f6a0d8c-f742-4c66-a163-fd2c37a22dbe

	measure 'P2 Presupuesto Seleccionado Base USD' =
			IF (
			    [P2 Categoría Única Seleccionada] = 1,
			    [P2 Presupuesto Final USD],
			    BLANK ()
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: c5897ff2-e214-4def-828d-34d707323064

	measure 'P2 Presupuesto Simulado Categoría USD' =
			VAR Base = [P2 Presupuesto Seleccionado Base USD]
			VAR Ajuste = [P2 Ajuste Simulado Seleccionado USD]
			RETURN
			IF ( [P2 Categoría Única Seleccionada] = 1, MAX ( 0, Base + Ajuste ), BLANK () )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: ed8695e5-7771-4feb-91de-2e336f85250a

	measure 'P2 Presupuesto Total Simulado USD' =
			VAR TotalGlobal = [P2 Presupuesto Final Global USD]
			VAR BaseCategoria = [P2 Presupuesto Seleccionado Base USD]
			VAR SimuladoCategoria = [P2 Presupuesto Simulado Categoría USD]
			RETURN
			IF (
			    [P2 Categoría Única Seleccionada] = 1,
			    TotalGlobal - BaseCategoria + SimuladoCategoria,
			    TotalGlobal
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: 02b015bf-1d37-44d8-b4af-c5157186af46

	measure 'P2 Ahorro Simulado USD' = [P2 Ingreso Sostenible Global] - [P2 Presupuesto Total Simulado USD]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: 6bc3d962-3f20-4827-8c50-ffe3abbbd623

	measure 'P2 % Ahorro Simulado' = DIVIDE ( [P2 Ahorro Simulado USD], [P2 Ingreso Sostenible Global] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: 3430f153-e27d-43aa-b4c3-1ed53e8d0ab1

	measure 'P2 Panel Simulación Texto' =
			IF (
			    [P2 Categoría Única Seleccionada] = 1,
			    "Sugerido: $" & FORMAT ( [P2 Presupuesto Seleccionado Base USD], "#,0.00" ) &
			        " · Ajuste: " & FORMAT ( [P2 Ajuste Simulado Seleccionado USD], "+$#,0;-$#,0;$0" ) &
			        " · Simulado: $" & FORMAT ( [P2 Presupuesto Simulado Categoría USD], "#,0.00" ) &
			        " · Nuevo total: $" & FORMAT ( [P2 Presupuesto Total Simulado USD], "#,0.00" ) &
			        " · Ahorro: $" & FORMAT ( [P2 Ahorro Simulado USD], "#,0.00" ) &
			        " (" & FORMAT ( [P2 % Ahorro Simulado], "0.00%" ) & ")",
			    "Selecciona una categoría para simular un ajuste."
			)
		displayFolder: 5. Planificador Próximo Mes\Simulación
		lineageTag: 04d14702-7fd6-4214-90d8-51d3c0dde822

	measure 'P2 Explicación Categoría' =
			VAR Tipo = SELECTEDVALUE ( Fact_Presupuestos[TipoForecast] )
			VAR Confianza = SELECTEDVALUE ( Fact_Presupuestos[ConfianzaPrediccion] )
			VAR Forecast = [P2 Forecast Próximo Mes USD]
			VAR Sugerido = [P2 Presupuesto Sugerido USD]
			VAR Factor = SELECTEDVALUE ( Fact_Presupuestos[FactorEscenario] )
			VAR Base =
			    SWITCH (
			        TRUE (),
			        Tipo = "FIXED", "Gasto recurrente estable. No se aplica reducción porque se considera un compromiso fijo.",
			        Tipo = "DEBT", "Obligación vigente. No se reduce artificialmente entre escenarios.",
			        Tipo = "SPARSE", "Gasto ocasional. El modelo evita extrapolar una compra puntual como gasto mensual recurrente.",
			        Tipo = "VARIABLE", "Consumo variable. El escenario seleccionado aplica el factor de comportamiento correspondiente.",
			        "Selecciona una categoría para ver la explicación."
			    )
			RETURN
			IF (
			    HASONEVALUE ( Dim_Categorias[IdCategoria] ),
			    Base & " Forecast: $" & FORMAT ( Forecast, "#,0.00" ) &
			        ". Factor aplicado: " & FORMAT ( Factor, "0.00" ) &
			        ". Presupuesto sugerido: $" & FORMAT ( Sugerido, "#,0.00" ) &
			        ". Confianza: " & Confianza & ".",
			    "Selecciona una categoría o subcategoría en la matriz para ver la explicación."
			)
		displayFolder: 5. Planificador Próximo Mes\Texto
		lineageTag: 8143b251-5f1d-4c78-be2a-7a74952a19d7

	measure 'P2 Presupuesto Actual Global USD' =
			CALCULATE (
			    [P2 Presupuesto Actual USD],
			    REMOVEFILTERS (
			        Dim_Categorias[IdCategoria],
			        Dim_Categorias[Categoria],
			        Dim_Categorias[Subcategoria]
			    ),
			    REMOVEFILTERS (
			        Fact_Presupuestos[IdCategoria],
			        Fact_Presupuestos[Categoria],
			        Fact_Presupuestos[Subcategoria]
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
