			)
		formatString: 0
		displayFolder: 1. Gastos
		lineageTag: e5bab63a-f098-4269-b817-bbd75bf58680

	measure 'Gasto Personal USD' =
			
			CALCULATE(
			    SUM(Fact_Movimientos[MontoUSD]),
			    Fact_Movimientos[Dominio] = "PERSONAL",
			    Fact_Movimientos[EsEgresoEconomico] = 1,
			    Fact_Movimientos[EsPresupuestable] = 1
			)
		formatString: 0
		displayFolder: 1. Gastos
		lineageTag: 6ef39230-fdc9-444c-82dc-e9a8747cb3cc

	measure 'Ingreso Personal USD' =
			
			CALCULATE(
			    SUM(Fact_Movimientos[MontoUSD]),
			    Fact_Movimientos[Dominio] = "PERSONAL",
			    Fact_Movimientos[EsIngresoEconomico] = 1
			)
		formatString: 0
		displayFolder: 3. Ingresos
		lineageTag: 1c27b2dd-b5e8-46fa-a449-439f5345a02b

	measure 'Ahorro Real USD' =
			
			[Ingreso Personal USD]
			    - [Gasto Personal USD]
		formatString: 0
		displayFolder: 4. Ahorros
		lineageTag: c2184c6e-7d26-4616-a718-b75910a6e18a

	measure 'Savings Rate' =
			
			DIVIDE (
			    [Ahorro Real USD],
			    [Ingreso Personal USD]
			)
		displayFolder: 0. Generales
		lineageTag: f4022f11-cd29-4041-b94a-ddc4ce63b36e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto USD' =
			
			VAR EscenarioSeleccionado =
			    SELECTEDVALUE(
			        Fact_Presupuestos[Escenario],
			        "REALISTIC"
			    )
			RETURN
			CALCULATE(
			    SUM(Fact_Presupuestos[MontoPresupuestadoUSD]),
			    REMOVEFILTERS(Fact_Presupuestos[Escenario]),
			    Fact_Presupuestos[Escenario] = EscenarioSeleccionado
			)
		displayFolder: 2. Presupuestos
		lineageTag: c5519cc0-0f39-4b28-87df-a186d0d3ba80

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto Restante USD' =
			
			[Presupuesto USD]
			    - [Gasto Personal USD]
		displayFolder: 2. Presupuestos
		lineageTag: 625504a3-e206-43d6-9d2b-b7e357d26b4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Presupuesto Consumido' =
			
			DIVIDE (
			    [Gasto Personal USD],
			    [Presupuesto USD]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 2. Presupuestos
		lineageTag: 65758d07-b73a-4d8a-bda7-0a51c9133cff

	measure 'Gasto Actual USD' =
			
			CALCULATE(
			    SUM(Fact_Movimientos[MontoUSD]),
			    Fact_Movimientos[Dominio] = "PERSONAL",
			    Fact_Movimientos[EsEgresoEconomico] = 1,
			    Fact_Movimientos[EsPresupuestable] = 1
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1. Gastos
		lineageTag: 6f5f452d-fc99-4357-931d-d7a773748e3e

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Disponible USD' =
			
			[Presupuesto USD] - [Gasto Actual USD]]
		displayFolder: 0. Generales
		lineageTag: c7cb5aa8-6f3a-4a2e-8aca-6729a3b4d1ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gasto Negocio USD' =
			
			CALCULATE(
			    SUM(Fact_Movimientos[MontoUSD]),
			    Fact_Movimientos[Dominio] = "NEGOCIO",
			    Fact_Movimientos[EsEgresoEconomico] = 1
			)
		displayFolder: 1. Gastos
		lineageTag: 000a1acc-d9d0-4dee-aeec-3fc2f4cafb07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salario Quincenal Mediano' =
			
			CALCULATE(
			    MEDIAN(Fact_Movimientos[MontoUSD]),
			
			    REMOVEFILTERS(Fact_Movimientos),
			    REMOVEFILTERS(Dim_Fecha),
			    REMOVEFILTERS(Dim_Quincena),
			    REMOVEFILTERS(Dim_Categorias),
			
			    Fact_Movimientos[Dominio] = "PERSONAL",
			    Fact_Movimientos[Categoria] = "Ingresos",
			    Fact_Movimientos[Subcategoria] = "Salario",
			    Fact_Movimientos[EsIngresoEconomico] = 1
			)
		displayFolder: 3. Ingresos
		lineageTag: cd991756-7c59-4caa-9b83-f75ea86698ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ingreso Sostenible Mensual' =
			
			[Salario Quincenal Mediano] * 2
		displayFolder: 3. Ingresos
		lineageTag: 717a8fee-941c-4f1a-9089-872b99fe7e1b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ahorro Objetivo USD' =
			
			[Ingreso Sostenible Mensual] - [Presupuesto USD]
		displayFolder: 4. Ahorros
		lineageTag: 7fbf8470-2b57-4f8d-853a-80b92881ede7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Savings Rate Objetivo' =
			
