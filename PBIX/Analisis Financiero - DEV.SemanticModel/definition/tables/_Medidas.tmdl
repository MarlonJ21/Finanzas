		formatString: 0
		displayFolder: 5. Planificador Próximo Mes\Confianza
		lineageTag: c7a56228-c534-4089-855e-56864c406f61

	measure 'P2 Confianza Baja' =
			CALCULATE (
			    DISTINCTCOUNT ( Fact_Presupuestos[IdCategoria] ),
			    Fact_Presupuestos[ConfianzaPrediccion] = "LOW"
